AI_API_KEY=
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5
AI_DEFAULT_TIMEOUT_MS=45000
AI_RESEARCH_TIMEOUT_MS=120000
AI_GLOBAL_CONCURRENCY=8
AI_CONCURRENCY_RETRY_AFTER_SECONDS=15
AI_WEB_SEARCH_STARTUP_DIAGNOSTIC=false

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_READER_CONCURRENCY=3

# PostgreSQL is the authoritative store for research tasks.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/deep_research
SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_SSL=false

# In-process API protection for the single-instance Web MVP.
API_TASK_OPERATION_CONCURRENCY=1
API_PLAN_WINDOW_MS=60000
API_PLAN_SESSION_LIMIT=4
API_PLAN_IP_LIMIT=20
API_PLAN_SESSION_CONCURRENCY=2

API_RESEARCH_WINDOW_MS=600000
API_RESEARCH_SESSION_LIMIT=2
API_RESEARCH_IP_LIMIT=8
API_RESEARCH_SESSION_CONCURRENCY=1
API_RESEARCH_IP_CONCURRENCY=2
API_RESEARCH_GLOBAL_CONCURRENCY=4

API_OUTLINE_WINDOW_MS=60000
API_OUTLINE_SESSION_LIMIT=4
API_OUTLINE_IP_LIMIT=20
API_OUTLINE_SESSION_CONCURRENCY=2

API_REPORT_WINDOW_MS=600000
API_REPORT_SESSION_LIMIT=2
API_REPORT_IP_LIMIT=8
API_REPORT_SESSION_CONCURRENCY=1
API_REPORT_GLOBAL_CONCURRENCY=2

API_CONCURRENCY_RETRY_AFTER_SECONDS=30
API_RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

# Keep false locally. Configure explicit proxy hops or addresses only after
# confirming the Railway proxy topology; true and * are intentionally ignored.
API_TRUST_PROXY=false

# Legacy MIMO_* names remain supported as fallbacks.
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5
# MIMO_DEFAULT_TIMEOUT_MS=45000
# MIMO_RESEARCH_TIMEOUT_MS=120000
